						endpoint {
							remote-endpoint = <0xb3>;
							data-lanes = <0x01 0x02 0x03 0x04>;
							link-frequencies = <0x00 0x3703dcc0 0x00 0x284af100>;
							phandle = <0xb4>;
						};
					};
				};
			};
		};

		camera-csis@17030000 {
			compatible = "samsung,exynos9820-csis";
			reg = <0x17030000 0x1000 0x170e0000 0x100 0x17020500 0x04 0x19160b00 0x500 0x170a0000 0x500>;
			reg-names = "csis", "dma-top", "phy-reset", "phy", "dma";
			interrupts = <0x00 0x135 0x04 0x00 0x13b 0x04>;
			interrupt-names = "csis", "dma";
			samsung,pmu-syscon = <0x21>;
			samsung,pmu-phy-offset = <0x70c>;
			samsung,phy-reset-bit = <0x00>;
			samsung,phy-dc-combo;
			power-domains = <0x72>;
			clock-names = "csis", "dma", "mmu", "bus";
			clocks = <0x73 0x06 0x73 0x04 0x73 0x05 0x15 0x60>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0xb4>;
						data-lanes = <0x01 0x02 0x03 0x04>;
						phandle = <0xb3>;
					};
				};
			};
		};
	};

	sram@2039000 {
		compatible = "mmio-sram";
		reg = <0x00 0x2039000 0x30000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x2039000 0x30000>;
		phandle = <0x12>;
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0a 0xff08>;
		clock-frequency = <0x18cba80>;
	};

	thermal-zones {

		cpucl0-thermal {
			polling-delay-passive = <0x32>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x43 0x02>;

			trips {

				little-switch-on {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				little-mitigate {
					temperature = <0x13880>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x44>;
				};

				little-hot {
					temperature = <0x19a28>;
					hysteresis = <0x1388>;
					type = "hot";
				};

				little-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x44>;
					cooling-device = <0x02 0x02 0xffffffff 0x03 0x02 0xffffffff 0x04 0x02 0xffffffff 0x05 0x02 0xffffffff>;
				};
			};
		};

		cpucl1-thermal {
			polling-delay-passive = <0x32>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x43 0x01>;

			trips {

				mid-switch-on {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				mid-mitigate {
					temperature = <0x14438>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x45>;
				};

				mid-hot {
					temperature = <0x19a28>;
					hysteresis = <0x1388>;
					type = "hot";
				};

				mid-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x45>;
					cooling-device = <0x06 0x02 0xffffffff 0x07 0x02 0xffffffff>;
				};
			};
		};

		cpucl2-thermal {
			polling-delay-passive = <0x19>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x43 0x00>;

			trips {

				big-switch-on {
					temperature = <0x124f8>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				big-mitigate {
					temperature = <0x14438>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x46>;
				};

				big-hotplug {
					temperature = <0x17700>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x47>;
				};

				big-hot {
					temperature = <0x19a28>;
					hysteresis = <0x1388>;
					type = "hot";
				};

				big-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x46>;
					cooling-device = <0x08 0xffffffff 0xffffffff 0x09 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x47>;
					cooling-device = <0x08 0x12 0x12 0x09 0x12 0x12>;
				};
			};
		};

		g3d-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x43 0x03>;

			trips {

				g3d-hot {
					temperature = <0x186a0>;
					hysteresis = <0x1388>;
					type = "hot";
				};

				g3d-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};

				s10-gpu-passive {
					temperature = <0xfde8>;
					hysteresis = <0x1388>;
					type = "passive";
					phandle = <0x64>;
				};
			};

			cooling-maps {

				s10-gpu-limit {
					trip = <0x64>;
					cooling-device = <0x65 0x05 0x05>;
				};
			};
		};

		isp-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x1388>;
			thermal-sensors = <0x43 0x04>;

			trips {

				isp-hot {
					temperature = <0x186a0>;
					hysteresis = <0x1388>;
					type = "hot";
				};

				isp-critical {
					temperature = <0x1adb0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};
	};

	battery {
		compatible = "simple-battery";
		over-voltage-threshold-microvolt = <0x44aa20>;
		voltage-min-design-microvolt = <0x3519c0>;
		voltage-max-design-microvolt = <0x426030>;
		constant-charge-current-max-microamp = <0x16e360>;
		charge-full-design-microamp-hours = <0x325aa0>;
		phandle = <0x36>;
	};

	chosen {
		samsung,postmarketos-cpuidle-test = "ananke-c2-production-v1";
		u-boot,version = "2026.01-gdec4927b4ad5";
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;
		stdout-path = "/soc@0/serial@10440000";

		framebuffer@ca000000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xca000000 0x10b3000>;
			width = <0x5a0>;
			height = <0xbe0>;
			stride = <0x1680>;
			format = "a8r8g8b8";
			panel = <0x48>;

			dummy-panel {
				width-mm = <0x42>;
				height-mm = <0x8c>;
				phandle = <0x48>;
			};
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0x49 0x4a 0x4b 0x4c>;
		pinctrl-names = "default";

		key-volup {
			label = "Volume Up Key";
			linux,code = <0x73>;
			gpios = <0x13 0x03 0x01>;
		};

		key-voldown {
			label = "Volume Down Key";
			linux,code = <0x72>;
			gpios = <0x13 0x04 0x01>;
		};

		key-wink {
			label = "Wink Key";
			linux,code = <0x98>;
			gpios = <0x13 0x06 0x01>;
		};

		key-power {
			label = "Power Key";
			linux,code = <0x74>;
			gpios = <0x4d 0x04 0x01>;
			wakeup-source;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x01>;
		ranges;

		sec_debug_magic@80000000 {
			reg = <0x00 0x80000000 0x1000>;
			no-map;
		};

		kaslr_seed@80001000 {
			reg = <0x00 0x80001000 0x1000>;
			no-map;
		};

		el2_code@87000000 {
			reg = <0x00 0x87000000 0x200000>;
			no-map;
		};

		mm_debug@91200000 {
			reg = <0x00 0x91200000 0x1000>;
			no-map;
		};

		secure_camera@96000000 {
			reg = <0x00 0x96000000 0x2200000>;
			no-map;
		};

		seclog_mem@c0000000 {
			reg = <0x00 0xc0000000 0x80000>;
			no-map;
		};

		framebuffer_region@ca000000 {
			iommu-addresses = <0xab 0xca000000 0x10b3000>;
			phandle = <0xa9>;
			reg = <0x00 0xca000000 0x10b3000>;
			no-map;
		};

		modem_spare@d0000000 {
			reg = <0x00 0xd0000000 0x1600000>;
			no-map;
		};

		modem_if@f0000000 {
			reg = <0x00 0xf0000000 0xb900000>;
			no-map;
		};

		cp_ram_logging@fb900000 {
			reg = <0x00 0xfb900000 0x2000000>;
			no-map;
		};

		el2_earlymem@9fd800000 {
			reg = <0x09 0xfd800000 0x2800000>;
			no-map;
		};
	};

	regulator-0 {
		compatible = "regulator-fixed";
		regulator-name = "dummy_reg";
		phandle = <0x22>;
	};

	gpio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "haptic";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x4e 0x07 0x00>;
		enable-active-high;
		regulator-boot-on;
		phandle = <0x34>;
	};

	s10-gpu-opp-table {
		compatible = "operating-points-v2";
		phandle = <0x63>;

		opp-156000000 {
			opp-hz = <0x00 0x94c5f00>;
		};

		opp-200000000 {
			opp-hz = <0x00 0xbebc200>;
		};

		opp-260000000 {
			opp-hz = <0x00 0xf7f4900>;
		};

		opp-325000000 {
			opp-hz = <0x00 0x135f1b40>;
		};

		opp-377000000 {
			opp-hz = <0x00 0x16789040>;
		};

		opp-433000000 {
			opp-hz = <0x00 0x19cf0e40>;
		};
	};
};
