/dts-v1/;

/ {
	compatible = "samsung,beyond1lte", "samsung,exynos9820";
	#address-cells = <0x02>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Samsung Galaxy S10 (SM-G973F)";
	chassis-type = "handset";

	memory {
		reg = <0x00 0x80000000 0x3ab00000 0x00 0xc0000000 0x20000000 0x00 0xe1900000 0x1e700000 0x08 0x80000000 0x80000000 0x09 0x00 0x80000000 0x09 0x80000000 0x80000000>;
		device_type = "memory";
	};

	aliases {
		pinctrl0 = "/soc@0/pinctrl@15850000";
		pinctrl1 = "/soc@0/pinctrl@18c60000";
		pinctrl2 = "/soc@0/pinctrl@15c30000";
		pinctrl3 = "/soc@0/pinctrl@13030000";
		pinctrl4 = "/soc@0/pinctrl@13c40000";
		pinctrl5 = "/soc@0/pinctrl@10430000";
		pinctrl6 = "/soc@0/pinctrl@10830000";
		pinctrl7 = "/soc@0/pinctrl@15580000";
		serial1 = "/soc@0/serial@10840000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x02>;
				};

				core1 {
					cpu = <0x03>;
				};

				core2 {
					cpu = <0x04>;
				};

				core3 {
					cpu = <0x05>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x06>;
				};

				core1 {
					cpu = <0x07>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x08>;
				};

				core1 {
					cpu = <0x09>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			clocks = <0x0a 0x02>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			capacity-dmips-mhz = <0x110>;
			dynamic-power-coefficient = <0xa0>;
			operating-points-v2 = <0x0c>;
			phandle = <0x02>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x01>;
			clocks = <0x0a 0x02>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			capacity-dmips-mhz = <0x110>;
			dynamic-power-coefficient = <0xa0>;
			operating-points-v2 = <0x0c>;
			phandle = <0x03>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x02>;
			clocks = <0x0a 0x02>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			capacity-dmips-mhz = <0x110>;
			dynamic-power-coefficient = <0xa0>;
			operating-points-v2 = <0x0c>;
			phandle = <0x04>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x03>;
			clocks = <0x0a 0x02>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0b>;
			capacity-dmips-mhz = <0x110>;
			dynamic-power-coefficient = <0xa0>;
			operating-points-v2 = <0x0c>;
			phandle = <0x05>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x04>;
			clocks = <0x0a 0x03>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x213>;
			dynamic-power-coefficient = <0x140>;
			operating-points-v2 = <0x0e>;
			phandle = <0x06>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x05>;
			clocks = <0x0a 0x03>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			capacity-dmips-mhz = <0x213>;
			dynamic-power-coefficient = <0x140>;
			operating-points-v2 = <0x0e>;
			phandle = <0x07>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m4";
			reg = <0x100>;
			clocks = <0x0a 0x04>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f>;
			capacity-dmips-mhz = <0x311>;
			dynamic-power-coefficient = <0x2f8>;
			operating-points-v2 = <0x10>;
			phandle = <0x08>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m4";
			reg = <0x101>;
			clocks = <0x0a 0x04>;
			#cooling-cells = <0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0f>;
			capacity-dmips-mhz = <0x311>;
			dynamic-power-coefficient = <0x2f8>;
			operating-points-v2 = <0x10>;
			phandle = <0x09>;
		};

		idle-states {
			entry-method = "psci";

			cpu-ananke-sleep {
				samsung,cpuidle-disabled-by-default = "deferred-until-userspace-v1";
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x46>;
				exit-latency-us = <0xa0>;
				min-residency-us = <0x7d0>;
				status = "okay";
				phandle = <0x0b>;
			};

			cpu-prometheus-sleep {
				samsung,cpuidle-disabled-by-default = "deferred-until-userspace-v1";
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x96>;
				exit-latency-us = <0xbe>;
				min-residency-us = <0x9c4>;
				status = "okay";
				phandle = <0x0d>;
			};

			cpu-cheetah-sleep {
				samsung,cpuidle-disabled-by-default = "deferred-until-userspace-v1";
				idle-state-name = "c2";
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0xeb>;
				exit-latency-us = <0xdc>;
				min-residency-us = <0xdac>;
				status = "okay";
				phandle = <0x0f>;
			};
		};
	};

	opp-table-0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x0c>;

		opp-442000000 {
			opp-hz = <0x00 0x1a586280>;
