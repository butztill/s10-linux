	firmware {

		power-management {
			compatible = "samsung,exynos9820-acpm-ipc";
			#clock-cells = <0x01>;
			assigned-clocks = <0x0a 0x00 0x0a 0x01 0x0a 0x02 0x0a 0x03 0x0a 0x04 0x0a 0x05 0x0a 0x06 0x0a 0x07 0x0a 0x08 0x0a 0x09 0x0a 0x0a 0x0a 0x0b 0x0a 0x0c 0x0a 0x0d 0x0a 0x0e>;
			assigned-clock-rates = <0x7cc0a540 0x1fd43180 0x3ec38140 0x48d63d80 0x52229c80 0x9f437c0 0x1fd43180 0x17d7840 0x119557c0 0x3f89de80 0x94c5f00 0x258d0980 0x26be3680 0x3567e00 0x7fcad80>;
			mboxes = <0x11>;
			shmem = <0x12>;
			phandle = <0x0a>;

			pmic-1 {
				compatible = "samsung,s2mps19-pmic";
				interrupts-extended = <0x13 0x01 0x08>;
				wakeup-source;

				regulators {

					ldo19m {
						regulator-name = "tsp_io";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						phandle = <0x1c>;
					};

					ldo27m {
						regulator-name = "tsp_avdd";
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-boot-on;
						phandle = <0x1b>;
					};

					ldo17m {
						regulator-name = "vdd_pmic_codec_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x58>;
					};

					ldo18m {
						regulator-name = "vdd_codec_1p2";
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						phandle = <0x59>;
					};

					ldo22m {
						regulator-name = "VDD_NFC_1P8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						regulator-always-on;
					};

					ldo21m {
						regulator-name = "vdd_mcu_1p8";
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-boot-on;
						regulator-always-on;
					};
				};
			};
		};
	};

	osc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-output-names = "oscclk";
		clock-frequency = <0x18cba80>;
		phandle = <0x14>;
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04 0x00 0x90 0x04>;
		interrupt-affinity = <0x02 0x03 0x04 0x05>;
	};

	pmu-a75 {
		compatible = "arm,cortex-a75-pmu";
		interrupts = <0x00 0x91 0x04 0x00 0x92 0x04>;
		interrupt-affinity = <0x06 0x07>;
	};

	pmu-mongoose-m4 {
		compatible = "samsung,mongoose-pmu";
		interrupts = <0x00 0xae 0x04 0x00 0xaf 0x04>;
		interrupt-affinity = <0x08 0x09>;
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_suspend = <0xc4000001>;
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x20000000>;

		watchdog@10050000 {
			status = "okay";
			timeout-sec = <0x14>;
			samsung,syscon-phandle = <0x21>;
			clock-names = "watchdog", "watchdog_src";
			clocks = <0x17 0x16 0x14>;
			interrupts = <0x00 0x1d0 0x04>;
			reg = <0x10050000 0x100>;
			compatible = "samsung,exynos9820-wdt";
		};

		sysmmu@190a0000 {
			phandle = <0xaa>;
			#iommu-cells = <0x00>;
			clocks = <0x39 0x3c>;
			clock-names = "sysmmu";
			interrupts = <0x00 0xd4 0x04>;
			reg = <0x190a0000 0x9000>;
			compatible = "samsung,exynos-sysmmu";
		};

		display-controller@19030000 {
			interrupt-names = "frame-done", "frame-start";
			phandle = <0xab>;
			iommus = <0xaa>;
			height-mm = <0x8c>;
			width-mm = <0x42>;
			interrupts = <0x00 0xb8 0x04 0x00 0xb7 0x04>;
