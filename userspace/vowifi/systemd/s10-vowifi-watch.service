[Unit]
Description=VoWiFi path watchdog (mobile data, CLAT, tunnel, IMS registration)
After=s10-vowifi-tun.service

[Service]
ExecStart=/usr/bin/python3 -u /home/user/s10-modem/vowifi/vowifi_watch.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
