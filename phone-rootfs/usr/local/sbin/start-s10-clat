#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# IPv6-only bearer -> DNS64-discovered 464XLAT. No assumed operator prefix.
set -eu
if ip -4 -o addr show dev rmnet0 scope global | grep -q .; then exit 0; fi
ip -6 -o addr show dev rmnet0 scope global | grep -q . || exit 0
dns=$(nmcli --escape no -g IP6.DNS device show ttyCP0 | python3 -c '
import sys,re,ipaddress
values=re.split(r"[\s|,]+", sys.stdin.read().strip())
out=[]
for value in values:
    if value:
        try: out.append(str(ipaddress.IPv6Address(value)))
        except ValueError: pass
print(",".join(out))')
exec perl /usr/local/sbin/s10-clatd \
    plat-dev=rmnet0 plat-prefix=64:ff9b::/96 clat-dev=s10clat \
    clat-v6-addr=derived proxynd-enable=0 \
    v4-conncheck-enable=0 v4-defaultroute-metric=900 \
    'script-up=/usr/local/sbin/s10-clat-policy up' \
    'script-down=/usr/local/sbin/s10-clat-policy down' \
    cmd-tayga=/usr/local/sbin/s10-tayga
