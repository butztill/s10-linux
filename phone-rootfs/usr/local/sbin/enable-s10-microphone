#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Register the tested capture card; do not reinitialize shared AUD clocks.
set -eu
test "$(uname -r)" = 7.2.0-rc2-s10-panfrost1
test -e /sys/firmware/devicetree/base/soc@0/usi@104700c0/spi@10470000/codec@0
modprobe snd_soc_cs47l92
modprobe snd_soc_s10_mic
udevadm settle --timeout=5
test -e /proc/asound/S10Mic/id
amixer -q -c S10Mic sset 'AIF1TX1 Input 1' IN3L
amixer -q -c S10Mic sset 'AIF1TX2 Input 1' IN4L
amixer -q -c S10Mic sset 'IN3L Digital' 0dB
amixer -q -c S10Mic sset 'IN4L Digital' 0dB
printf '%s\n' 'S10 microphones ready: IN3L/IN4L -> AIF1 -> UAIF0 -> WDMA1.'
