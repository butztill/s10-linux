#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Only IPv6 packets generated by this translator use the cellular uplink.
# Wi-Fi's main-table preference is untouched. Own just table/rule 1431.
set -eu
marker=/run/s10-clat/policy-owned
case "${1:-}" in
    up)
        test ! -e "$marker"
        test -z "$(ip -6 route show table 1431 2>/dev/null)"
        ip -6 route add default dev rmnet0 table 1431 metric 700
        touch "$marker"
        ip -6 rule add priority 1431 iif s10clat lookup 1431
        ;;
    down)
        if test -e "$marker"; then
            ip -6 rule del priority 1431 iif s10clat lookup 1431 || true
            ip -6 route del default dev rmnet0 table 1431 metric 700 || true
            rm "$marker"
        fi
        ;;
    *) exit 2 ;;
esac
