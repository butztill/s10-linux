[Unit]
Description=Power on S10 NFC controller
After=neard.service
Wants=neard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sh -c "for i in $(seq 30); do [ -e /sys/class/nfc/nfc0 ] && exit 0; sleep 1; done; exit 1"
ExecStart=/usr/bin/nfctool -d nfc0 -1
ExecStartPost=-/bin/sh -c "systemctl restart neard; sleep 2; busctl call org.neard /org/neard/nfc0 org.neard.Adapter StartPollLoop s Initiator"
ExecStop=/usr/bin/nfctool -d nfc0 -0

[Install]
WantedBy=multi-user.target
