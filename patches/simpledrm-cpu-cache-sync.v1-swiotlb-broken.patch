+/*
+ * Non-coherent GPUs (Exynos9820 Mali-G76) render into shmem-backed dumb
+ * buffers behind the CPU cache. Invalidate the CPU's view of the damaged rows
+ * before the scanout copy reads them, so stale cache lines are not shown.
+ */
+bool drm_sysfb_cpu_cache_sync;
+EXPORT_SYMBOL(drm_sysfb_cpu_cache_sync);
+module_param_named(cpu_cache_sync, drm_sysfb_cpu_cache_sync, bool, 0444);
+MODULE_PARM_DESC(cpu_cache_sync, "Invalidate CPU caches of native shmem buffers before the scanout copy");
+
+static void drm_sysfb_sync_damage_for_cpu(struct drm_framebuffer *fb,
+					  struct drm_plane_state *old_state,
+					  struct drm_plane_state *new_state)
+{
+	struct drm_gem_object *obj = fb->obj[0];
+	struct drm_atomic_helper_damage_iter iter;
+	struct drm_rect damage;
+	struct drm_gem_shmem_object *shmem;
+	struct scatterlist *sg;
+	struct sg_table *sgt;
+	size_t start, end, off = 0;
+	int y1 = INT_MAX, y2 = 0;
+	unsigned int i;
+
+	if (!drm_sysfb_cpu_cache_sync || !obj || drm_gem_is_imported(obj))
+		return;
+
+	drm_atomic_helper_damage_iter_init(&iter, old_state, new_state);
+	drm_atomic_for_each_plane_damage(&iter, &damage) {
+		y1 = min(y1, damage.y1);
+		y2 = max(y2, damage.y2);
+	}
+	if (y2 <= y1)
+		return;
+
+	shmem = to_drm_gem_shmem_obj(obj);
+	sgt = drm_gem_shmem_get_pages_sgt(shmem);
+	if (IS_ERR(sgt))
+		return;
+
+	start = fb->offsets[0] + (size_t)y1 * fb->pitches[0];
+	end = min_t(size_t, fb->offsets[0] + (size_t)y2 * fb->pitches[0], obj->size);
+
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		size_t len = sg_dma_len(sg);
+
+		if (off >= end)
+			break;
+		if (off + len > start) {
+			size_t lo = max(start, off);
+			size_t hi = min(end, off + len);
+
+			dma_sync_single_for_cpu(obj->dev->dev,
+						sg_dma_address(sg) + (lo - off),
+						hi - lo, DMA_FROM_DEVICE);
+		}
+		off += len;
+	}
+}
