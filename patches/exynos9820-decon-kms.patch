+		.of_match_table = s10_decon_of_match,
+	},
+	.probe = s10_decon_probe,
+	.remove = s10_decon_remove,
+	.shutdown = s10_decon_shutdown,
+};
+module_platform_driver(s10_decon_platform_driver);
