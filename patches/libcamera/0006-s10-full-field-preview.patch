--- /dev/null
+++ b/src/libcamera/software_isp/s10_bayer_resize.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace libcamera {
+/* Resize unpacked RAW10 before demosaicing, keeping each Bayer phase separate.
+ * Unlike the original CPU ISP's centre crop, this covers the sensor's full
+ * horizontal/vertical field subject only to matching the output aspect ratio.
+ * Nearest 2x2-cell sampling is intentionally conservative about colour phase;
+ * it is not a calibrated photographic resampler. */
+class S10BayerResize
+{
+public:
+	bool configure(unsigned int sw, unsigned int sh, unsigned int stride,
+		       unsigned int dw, unsigned int dh, unsigned int aspectW, unsigned int aspectH)
+	{
+		if (sw < 4 || sh < 4 || dw < 4 || dh < 4 ||
+		    (sw | sh | dw | dh) & 1 || stride < sw * 2 || !aspectW || !aspectH)
+			return false;
+		unsigned int cw = sw, ch = sh;
+		if (uint64_t(sw) * aspectH > uint64_t(sh) * aspectW)
+			cw = (uint64_t(sh) * aspectW / aspectH) & ~1U;
+		else
+			ch = (uint64_t(sw) * aspectH / aspectW) & ~1U;
+		if (cw < 2 || ch < 2)
+			return false;
+		unsigned int ox = ((sw - cw) / 2) & ~1U;
+		unsigned int oy = ((sh - ch) / 2) & ~1U;
+		x_.resize(dw); y_.resize(dh);
+		for (unsigned int x = 0; x < dw; ++x)
+			x_[x] = ox + 2 * std::min<uint64_t>(cw / 2 - 1,
+				(uint64_t(2 * (x / 2) + 1) * (cw / 2)) / dw) + (x & 1);
+		for (unsigned int y = 0; y < dh; ++y)
+			y_[y] = oy + 2 * std::min<uint64_t>(ch / 2 - 1,
+				(uint64_t(2 * (y / 2) + 1) * (ch / 2)) / dh) + (y & 1);
+		stride_ = stride;
+		length_ = size_t(sh - 1) * stride + sw * 2;
+		pixels_.resize(size_t(dw) * dh * 2);
+		return true;
+	}
+	bool process(const uint8_t *src, size_t length)
+	{
+		if (!src || length < length_ || pixels_.empty())
+			return false;
+		uint8_t *dst = pixels_.data();
+		for (unsigned int y : y_) {
+			const uint8_t *line = src + size_t(y) * stride_;
+			for (unsigned int x : x_) {
+				*dst++ = line[2 * x];
+				*dst++ = line[2 * x + 1];
+			}
+		}
+		return true;
+	}
+	const uint8_t *data() const { return pixels_.data(); }
+private:
+	unsigned int stride_ = 0;
+	size_t length_ = 0;
+	std::vector<unsigned int> x_, y_;
+	std::vector<uint8_t> pixels_;
+};
+} /* namespace libcamera */
