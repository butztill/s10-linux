+int Agc::configure(IPAContext &context, [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	const double lineUs = context.configuration.agc.lineDuration.get<std::micro>();
+	if (lineUs <= 0.0)
+		return -EINVAL;
+
+	const int32_t minExposureUs = std::max(1, static_cast<int32_t>(std::lround(
+		context.configuration.agc.exposureMin * lineUs)));
+	const int32_t maxExposureUs = std::max(minExposureUs, static_cast<int32_t>(std::lround(
+		context.configuration.agc.exposureMax * lineUs)));
+	const int32_t defaultExposureUs = std::clamp(20000, minExposureUs, maxExposureUs);
+
+	context.ctrlMap[&controls::AeEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ExposureValue] = ControlInfo(-2.0f, 2.0f, 0.0f);
+	context.ctrlMap[&controls::ExposureTimeMode] = ControlInfo(0, 1, 0);
+	context.ctrlMap[&controls::ExposureTime] = ControlInfo(minExposureUs, maxExposureUs,
+									 defaultExposureUs);
+	context.ctrlMap[&controls::AnalogueGainMode] = ControlInfo(0, 1, 0);
+	context.ctrlMap[&controls::AnalogueGain] = ControlInfo(
+		static_cast<float>(context.configuration.agc.againMin),
+		static_cast<float>(context.configuration.agc.againMax),
+		static_cast<float>(context.configuration.agc.again10));
+
+	context.activeState.agc.exposureAuto = true;
+	context.activeState.agc.gainAuto = true;
+	context.activeState.agc.exposureValue = 0.0f;
+	return 0;
+}
+
+void Agc::queueRequest(typename Module::Context &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] typename Module::FrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &agc = context.activeState.agc;
+	if (auto enable = controls.get(controls::AeEnable)) {
+		agc.exposureAuto = *enable;
+		agc.gainAuto = *enable;
+	}
+	if (auto mode = controls.get(controls::ExposureTimeMode))
+		agc.exposureAuto = *mode == controls::ExposureTimeModeAuto;
+	if (auto mode = controls.get(controls::AnalogueGainMode))
+		agc.gainAuto = *mode == controls::AnalogueGainModeAuto;
+	if (auto value = controls.get(controls::ExposureValue))
+		agc.exposureValue = *value;
+	if (auto value = controls.get(controls::ExposureTime)) {
+		const double lineUs = context.configuration.agc.lineDuration.get<std::micro>();
+		if (lineUs > 0.0)
+			agc.exposure = std::clamp(static_cast<int32_t>(std::lround(*value / lineUs)),
+					  context.configuration.agc.exposureMin,
+					  context.configuration.agc.exposureMax);
+	}
+	if (auto value = controls.get(controls::AnalogueGain))
+		agc.again = std::clamp<double>(*value,
+					       context.configuration.agc.againMin,
+					       context.configuration.agc.againMax);
+}
