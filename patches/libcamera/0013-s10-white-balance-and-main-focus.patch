+
+void Awb::queueRequest(IPAContext &context,
+                       [[maybe_unused]] const uint32_t frame,
+                       IPAFrameContext &frameContext, const ControlList &controls)
+{
+	auto &awb = context.activeState.awb;
+	if (const auto enabled = controls.get(controls::AwbEnable))
+		awb.enabled = *enabled;
+	if (!awb.enabled) {
+		if (const auto gains = controls.get(controls::ColourGains)) {
+			if (std::isfinite((*gains)[0]) && std::isfinite((*gains)[1]))
+				awb.gains = {{ std::clamp((*gains)[0], 0.25f, 4.0f), 1.0f,
+				               std::clamp((*gains)[1], 0.25f, 4.0f) }};
+		}
+	}
+	frameContext.awbEnabled = awb.enabled;
+	frameContext.gains = awb.gains;
 }
 
