+/**
+ * \brief Read the current kernel lens position, in driver units
+ * \param[out] position The position returned by the lens driver
+ * \return 0 on success, or -EIO if reading the control failed
+ */
+int CameraLens::getFocusPosition(int32_t *position)
+{
+	static constexpr uint32_t ids[] = { V4L2_CID_FOCUS_ABSOLUTE };
+	ControlList values = subdev_->getControls(ids);
+	const ControlValue &value = values.get(V4L2_CID_FOCUS_ABSOLUTE);
+	if (value.isNone())
+		return -EIO;
+	*position = value.get<int32_t>();
+	return 0;
+}
