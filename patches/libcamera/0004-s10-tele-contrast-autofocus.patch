+
+void SimpleCameraData::autofocusControls(const ControlList &ctrls)
+{
+	if (auto mode = ctrls.get(controls::AfMode); mode && *mode >= 0 && *mode <= 2)
+		autofocus_.setMode(static_cast<S10Autofocus::Mode>(*mode), autofocusTime());
+	if (auto trigger = ctrls.get(controls::AfTrigger))
+		autofocus_.trigger(*trigger == controls::AfTriggerCancel, autofocusTime());
+	if (auto pause = ctrls.get(controls::AfPause); pause && *pause >= 0 && *pause <= 2)
+		autofocus_.pause(*pause, autofocusTime());
+}
+
+void SimpleCameraData::startAutofocus(const ControlList *ctrls)
+{
+	if (!autofocusAvailable_ || !afWidth_)
+		return;
+	int32_t position;
+	if (sensor_->focusLens()->getFocusPosition(&position)) {
+		LOG(SimplePipeline, Warning) << "Cannot read focus; disabling AF for this stream";
+		afWidth_ = 0;
+		return;
+	}
+	autofocus_.reset(position, S10Autofocus::Continuous, autofocusTime());
+	if (ctrls)
+		autofocusControls(*ctrls);
+}
+
+void SimpleCameraData::autofocusFrame(FrameBuffer *buffer, Request *request)
+{
+	if (!autofocusAvailable_ || !afWidth_ || !request)
+		return;
+	autofocusControls(request->controls());
+	auto previousState = autofocus_.state();
+	if (autofocus_.mode() != S10Autofocus::Manual && autofocus_.pauseState() != 2) {
+		auto &mapped = afMappings_[buffer];
+		if (!mapped)
+			mapped = std::make_unique<MappedFrameBuffer>(buffer, MappedFrameBuffer::MapFlag::Read);
+		S10Autofocus::Measure measure;
+		if (mapped->isValid() && mapped->planes().size() == 1 &&
+		    buffer->metadata().planes().size() == 1) {
+			DmaSyncer sync(buffer->planes()[0].fd, DmaSyncer::SyncType::Read);
+			const auto &plane = mapped->planes()[0];
+			size_t length = std::min<size_t>(plane.size(), buffer->metadata().planes()[0].bytesused);
+			measure = S10Autofocus::measure(plane.data(), length,
+						      afWidth_, afHeight_, afStride_);
+		}
+		autofocus_.update(measure, autofocusTime(), [this](int position) {
+			int ret = sensor_->focusLens()->setFocusPosition(position);
+			LOG(SimplePipeline, Debug) << "S10 AF move " << position << " result " << ret;
+			return ret;
+		});
+	}
+	if (previousState != autofocus_.state()) {
+		LOG(SimplePipeline, Info) << "S10 AF state " << autofocus_.state()
+			<< " motor " << autofocus_.position();
+		for (const auto &[position, score] : autofocus_.scores())
+			LOG(SimplePipeline, Debug) << "S10 AF sample " << position << " contrast " << score;
+	}
+	request->_d()->metadata().set(controls::AfMode, static_cast<int32_t>(autofocus_.mode()));
+	request->_d()->metadata().set(controls::AfState, static_cast<int32_t>(autofocus_.state()));
+	request->_d()->metadata().set(controls::AfPauseState, autofocus_.pauseState());
+}
