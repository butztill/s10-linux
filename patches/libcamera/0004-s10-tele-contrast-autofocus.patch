+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <map>
+#include <vector>
+
+namespace libcamera {
+
+/* Experimental, uncalibrated S5K3M3/AK7374 contrast AF. Positions are motor
+ * codes, never dioptres. Keep the controller independent of capture/IPC. */
+class S10Autofocus
+{
+public:
+	enum Mode { Manual, Auto, Continuous };
+	enum State { Idle, Scanning, Focused, Failed };
+	struct Measure { double contrast = 0; double mean = 0; bool valid = false; };
+	using Move = std::function<int(int)>;
+
+	/* GRBG10 unpacked in little-endian 16-bit words. Sample only one green
+	 * phase in a central ROI, excluding black/saturated scenes. Normalizing
+	 * by mean signal squared reduces sensitivity to exposure changes. */
+	static Measure measure(const uint8_t *data, size_t length,
+			       unsigned int width, unsigned int height, unsigned int stride)
+	{
+		if (!data || width < 32 || height < 32 || stride < width * 2 ||
+		    length < size_t(height - 1) * stride + width * 2)
+			return {};
+		auto pixel = [&](unsigned int x, unsigned int y) {
+			const uint8_t *p = data + size_t(y) * stride + x * 2;
+			return int(p[0] | (p[1] << 8));
+		};
+		unsigned int roi = std::min({ 512U, width / 2, height / 2 }) & ~1U;
+		unsigned int x0 = ((width - roi) / 2) & ~1U;
+		unsigned int y0 = ((height - roi) / 2) & ~1U;
+		double energy = 0, signal = 0;
+		unsigned int count = 0, saturated = 0;
+		for (unsigned int y = y0; y < y0 + roi; y += 4) {
+			for (unsigned int x = x0; x < x0 + roi; x += 4) {
+				int c = pixel(x, y);
+				saturated += c >= 1000;
+				signal += std::max(c - 64, 0);
+				int dx = pixel(x + 2, y) - pixel(x - 2, y);
+				int dy = pixel(x, y + 2) - pixel(x, y - 2);
+				energy += double(dx) * dx + double(dy) * dy;
+				++count;
+			}
+		}
+		double mean = signal / count;
+		return { energy / (2 * count * std::max(mean * mean, 1.0)), mean,
+			 mean >= 12 && saturated < count / 5 };
+	}
+
+	void reset(int position, Mode mode, uint64_t now)
+	{
+		*this = S10Autofocus();
+		position_ = std::clamp(position, 0, 511);
+		mode_ = mode;
+		if (mode == Continuous)
+			begin(now);
+	}
+
+	void setMode(Mode mode, uint64_t now)
+	{
+		if (mode == mode_)
+			return;
+		mode_ = mode;
+		state_ = Idle;
+		paused_ = deferred_ = false;
+		if (mode == Continuous)
+			begin(now);
+	}
+
+	void trigger(bool cancel, uint64_t now)
+	{
+		if (mode_ != Auto)
+			return;
+		if (cancel) {
+			state_ = Idle; /* Cancellation holds the current position. */
+		} else if (state_ != Scanning) {
+			begin(now);
+		}
+	}
+
+	void pause(int value, uint64_t now)
+	{
+		if (mode_ != Continuous)
+			return;
+		if (value == 2) {
+			if (paused_ && state_ == Scanning) {
+				deadline_ = now + kTimeout;
+				skip_ = 4;
+				samples_.clear();
+			}
+			paused_ = deferred_ = false;
+		} else if (value == 1 && state_ == Scanning) {
+			deferred_ = true;
+		} else {
+			paused_ = true;
+			deferred_ = false;
+		}
+	}
+
+	void update(Measure m, uint64_t now, const Move &move)
+	{
+		if (mode_ == Manual || paused_)
+			return;
+		if (state_ != Scanning) {
+			if (mode_ != Continuous || now < cooldown_)
+				return;
+			bool changed = state_ == Failed ? m.valid :
+				!m.valid || m.contrast < locked_ * 0.65 ||
+				m.mean < lockedMean_ * 0.65 || m.mean > lockedMean_ * 1.5;
+			changed_ = changed ? changed_ + 1 : 0;
+			if (changed_ >= 8)
+				begin(now);
+			return;
+		}
+		if (now >= deadline_) {
+			finish(false, now, move);
+			return;
+		}
+		if (skip_) {
+			--skip_;
+			return;
+		}
+		if (!m.valid || !std::isfinite(m.contrast)) {
+			if (++invalid_ >= 8)
+				finish(false, now, move);
+			return;
+		}
+		invalid_ = 0;
+		samples_.push_back(m.contrast);
+		if (samples_.size() < 3)
+			return;
+		std::sort(samples_.begin(), samples_.end());
+		double score = samples_[1];
+		samples_.clear();
+		if (phase_ == Warmup) {
+			points_.clear();
+			for (int p = 0; p < 511; p += 64)
+				points_.push_back(p);
+			points_.push_back(511);
+			phase_ = Coarse;
+			index_ = 0;
+			advance(points_[0], now, move);
+			return;
+		}
+		if (phase_ == Verify) {
+			locked_ = score;
+			lockedMean_ = m.mean;
+			double worst = std::numeric_limits<double>::max();
+			for (auto [pos, value] : scores_)
+				worst = std::min(worst, value);
+			bool ok = score > 0.0001 && score >= bestScore_ * 0.7 &&
+				bestScore_ > worst * 1.15;
+			finish(ok, now, move);
+			return;
+		}
+		scores_[position_] = score;
+		if (++index_ < points_.size()) {
+			advance(points_[index_], now, move);
+			return;
+		}
+		auto best = std::max_element(scores_.begin(), scores_.end(),
+			[](const auto &a, const auto &b) { return a.second < b.second; });
+		bestPosition_ = best->first;
+		bestScore_ = best->second;
+		if (phase_ == Coarse) {
+			points_.clear();
+			for (int p = std::max(0, bestPosition_ - 48);
+			     p <= std::min(511, bestPosition_ + 48); p += 16) {
+				if (!scores_.count(p))
+					points_.push_back(p);
+			}
+			phase_ = Fine;
+			index_ = 0;
+			if (!points_.empty()) {
+				advance(points_[0], now, move);
+				return;
+			}
+		}
+		phase_ = Verify;
+		advance(bestPosition_, now, move);
+	}
+
+	Mode mode() const { return mode_; }
+	State state() const { return state_; }
+	int pauseState() const { return paused_ ? 2 : deferred_ ? 1 : 0; }
+	int position() const { return position_; }
+	const std::map<int, double> &scores() const { return scores_; }
+
+private:
+	static constexpr uint64_t kTimeout = 30000000000ULL;
+	enum Phase { Warmup, Coarse, Fine, Verify };
+	void begin(uint64_t now)
+	{
+		state_ = Scanning;
+		phase_ = Warmup;
+		origin_ = position_;
+		deadline_ = now + kTimeout;
+		skip_ = 12; /* Allow AGC to settle before comparing lens positions. */
+		invalid_ = changed_ = 0;
+		points_.clear();
+		samples_.clear();
+		scores_.clear();
+	}
+	void advance(int position, uint64_t now, const Move &move)
+	{
+		if (move(position)) {
+			finish(false, now, move);
+			return;
+		}
+		position_ = position;
+		skip_ = 4; /* Discard captured/in-flight frames and motor settling. */
+		samples_.clear();
+	}
+	void finish(bool success, uint64_t now, const Move &move)
+	{
+		if (!success && position_ != origin_ && !move(origin_))
+			position_ = origin_;
+		state_ = success ? Focused : Failed;
+		cooldown_ = now + (success ? 5000000000ULL : 15000000000ULL);
+		changed_ = 0;
+		if (deferred_) {
+			paused_ = true;
+			deferred_ = false;
+		}
+	}
+	Mode mode_ = Manual;
+	State state_ = Idle;
+	Phase phase_ = Warmup;
+	int position_ = 120, origin_ = 120, bestPosition_ = 120;
+	unsigned int skip_ = 0, invalid_ = 0, changed_ = 0;
+	size_t index_ = 0;
+	uint64_t deadline_ = 0, cooldown_ = 0;
+	double bestScore_ = 0, locked_ = 0, lockedMean_ = 0;
+	bool paused_ = false, deferred_ = false;
+	std::vector<int> points_;
+	std::vector<double> samples_;
+	std::map<int, double> scores_;
+};
+
+} /* namespace libcamera */
