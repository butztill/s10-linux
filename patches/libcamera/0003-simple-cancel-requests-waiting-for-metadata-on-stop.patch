+	std::set<Request *> cancelled;
+
 	while (!conversionQueue_.empty()) {
+		cancelled.insert(conversionQueue_.front().request);
 		pipe()->cancelRequest(conversionQueue_.front().request);
 		conversionQueue_.pop();
