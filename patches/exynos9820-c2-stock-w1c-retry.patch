+
+/* Stock PMUCAL retries a W1C until the interrupt-pending bit is gone. */
+#define EXYNOS9820_UPEND_RETRY_US 1000
+
+static int exynos9820_clear_pending(struct exynos_pmu_context *ctx,
+				    unsigned int status_reg,
+				    unsigned int clear_reg, u32 mask)
+{
+	u32 pending;
+	unsigned int retry;
+	int ret;
+
+	for (retry = 0; retry <= EXYNOS9820_UPEND_RETRY_US; retry++) {
+		ret = regmap_read(ctx->pmuintrgen, status_reg, &pending);
+		if (ret)
+			return ret;
+		if (!(pending & mask))
+			return 0;
+
+		if (retry == EXYNOS9820_UPEND_RETRY_US)
+			break;
+
+		ret = regmap_write(ctx->pmuintrgen, clear_reg, mask);
+		if (ret)
+			return ret;
+		udelay(1);
+	}
+
+	return -ETIMEDOUT;
+}
 
