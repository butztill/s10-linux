--- a/drivers/gpu/drm/sysfb/simpledrm.c
+++ b/drivers/gpu/drm/sysfb/simpledrm.c
@@ -848,8 +848,39 @@
 
 DEFINE_DRM_GEM_FOPS(simpledrm_fops);
 
+/*
+ * With cpu_cache_sync, write back the freshly zeroed pages of new dumb
+ * buffers before the GPU renders into them; dirty CPU lines would otherwise
+ * be evicted over GPU-written pixels later.
+ */
+static int simpledrm_dumb_create(struct drm_file *file, struct drm_device *dev,
+				 struct drm_mode_create_dumb *args)
+{
+	struct drm_gem_shmem_object *shmem;
+	struct drm_gem_object *obj;
+	int ret;
+
+	ret = drm_gem_shmem_dumb_create(file, dev, args);
+	if (ret || !drm_sysfb_cpu_cache_sync)
+		return ret;
+
+	obj = drm_gem_object_lookup(file, args->handle);
+	if (!obj)
+		return 0;
+
+	shmem = to_drm_gem_shmem_obj(obj);
+	if (!drm_gem_shmem_pin(shmem)) {
+		drm_sysfb_cache_clean_inval(shmem, 0, obj->size);
+		drm_gem_shmem_unpin(shmem);
+	}
+	drm_gem_object_put(obj);
+
+	return 0;
+}
