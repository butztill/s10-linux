+/*
+ * Non-coherent GPUs (Exynos9820 Mali-G76) render into shmem-backed dumb
+ * buffers behind the CPU cache. Clean and invalidate the CPU's view of the
+ * damaged rows before the scanout copy reads them, so stale cache lines are
+ * not shown and CPU-written pixels are kept.
+ *
+ * This works on the pages directly: the sysfb device is no DMA master, and
+ * the DMA API would bounce its mappings through swiotlb.
+ */
+bool drm_sysfb_cpu_cache_sync;
+EXPORT_SYMBOL(drm_sysfb_cpu_cache_sync);
+module_param_named(cpu_cache_sync, drm_sysfb_cpu_cache_sync, bool, 0444);
+MODULE_PARM_DESC(cpu_cache_sync, "Clean and invalidate CPU caches of native shmem buffers before the scanout copy");
+
+void drm_sysfb_cache_clean_inval(struct drm_gem_shmem_object *shmem, size_t start, size_t end)
+{
+#if IS_BUILTIN(CONFIG_DRM_SYSFB_HELPER) && \
+	IS_ENABLED(CONFIG_ARCH_HAS_SYNC_DMA_FOR_DEVICE) && \
+	IS_ENABLED(CONFIG_ARCH_HAS_SYNC_DMA_FOR_CPU)
+	size_t off;
+
+	end = min(end, shmem->base.size);
+	if (!shmem->pages)
+		return;
+
+	for (off = start & PAGE_MASK; off < end; off += PAGE_SIZE) {
+		size_t lo = max(start, off);
+		size_t hi = min(end, off + PAGE_SIZE);
+		phys_addr_t phys = page_to_phys(shmem->pages[off >> PAGE_SHIFT]) + (lo - off);
+
+		arch_sync_dma_for_device(phys, hi - lo, DMA_TO_DEVICE);
+		arch_sync_dma_for_cpu(phys, hi - lo, DMA_FROM_DEVICE);
+	}
+#endif
+}
+
+static void drm_sysfb_sync_damage_for_cpu(struct drm_framebuffer *fb,
+					  struct drm_plane_state *old_state,
+					  struct drm_plane_state *new_state)
+{
+	struct drm_gem_object *obj = fb->obj[0];
+	struct drm_atomic_helper_damage_iter iter;
+	struct drm_rect damage;
+	int y1 = INT_MAX, y2 = 0;
+
+	if (!drm_sysfb_cpu_cache_sync || !obj || drm_gem_is_imported(obj))
+		return;
+
+	drm_atomic_helper_damage_iter_init(&iter, old_state, new_state);
+	drm_atomic_for_each_plane_damage(&iter, &damage) {
+		y1 = min(y1, damage.y1);
+		y2 = max(y2, damage.y2);
+	}
+	if (y2 <= y1)
+		return;
+
+	/* The shadow-plane vmap keeps the pages pinned during the update. */
+	drm_sysfb_cache_clean_inval(to_drm_gem_shmem_obj(obj),
+				    fb->offsets[0] + (size_t)y1 * fb->pitches[0],
+				    fb->offsets[0] + (size_t)y2 * fb->pitches[0]);
+}
