+
+/* Most recent CPU_SUSPEND firmware call on a specified CPU. */
+struct psci_cpu_suspend_result {
+	s32 firmware_result;
+	u32 function_id;
+	u32 power_state;
+	unsigned long entry_point;
+	u64 calls;
+};
+
+void psci_get_cpu_suspend_result(unsigned int cpu,
+				 struct psci_cpu_suspend_result *result);
+u64 psci_cpu_suspend_call_count(unsigned int cpu);
 
 struct psci_operations {
 	u32 (*get_version)(void);
--- a/s10-kernel/src/drivers/firmware/psci/psci.c
+++ b/s10-kernel/src/drivers/firmware/psci/psci.c
@@ -13,6 +13,7 @@
 #include <linux/errno.h>
 #include <linux/linkage.h>
 #include <linux/of.h>
+#include <linux/percpu.h>
 #include <linux/pm.h>
 #include <linux/printk.h>
 #include <linux/psci.h>
@@ -61,6 +62,28 @@
 static psci_fn *invoke_psci_fn;
 
 static struct psci_0_1_function_ids psci_0_1_function_ids;
+static DEFINE_PER_CPU(struct psci_cpu_suspend_result, psci_cpu_suspend_result);
+
+void psci_get_cpu_suspend_result(unsigned int cpu,
+				 struct psci_cpu_suspend_result *result)
+{
+	struct psci_cpu_suspend_result *last =
+		per_cpu_ptr(&psci_cpu_suspend_result, cpu);
+
+	result->firmware_result = READ_ONCE(last->firmware_result);
+	result->function_id = READ_ONCE(last->function_id);
+	result->power_state = READ_ONCE(last->power_state);
+	result->entry_point = READ_ONCE(last->entry_point);
+	result->calls = READ_ONCE(last->calls);
+}
+
+u64 psci_cpu_suspend_call_count(unsigned int cpu)
+{
+	struct psci_cpu_suspend_result *last =
+		per_cpu_ptr(&psci_cpu_suspend_result, cpu);
+
+	return READ_ONCE(last->calls);
+}
 
 struct psci_0_1_function_ids get_psci_0_1_function_ids(void)
 {
@@ -176,10 +199,20 @@
 static __always_inline int
 __psci_cpu_suspend(u32 fn, u32 state, unsigned long entry_point)
 {
-	int err;
-
-	err = invoke_psci_fn(fn, state, entry_point, 0);
-	return psci_to_linux_errno(err);
+	u32 fw_result;
+
+	fw_result = invoke_psci_fn(fn, state, entry_point, 0);
+	{
+		struct psci_cpu_suspend_result *last =
+			this_cpu_ptr(&psci_cpu_suspend_result);
+
+		WRITE_ONCE(last->firmware_result, (s32)fw_result);
+		WRITE_ONCE(last->function_id, fn);
+		WRITE_ONCE(last->power_state, state);
+		WRITE_ONCE(last->entry_point, entry_point);
+		WRITE_ONCE(last->calls, READ_ONCE(last->calls) + 1);
+	}
+	return psci_to_linux_errno((s32)fw_result);
 }
 
