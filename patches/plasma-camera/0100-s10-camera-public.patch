+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "photoprocessing.h"
+#include <algorithm>
+#include <array>
+#include <thread>
+#include <vector>
+
+QImage S10Photo::preview(const QImage &input, int maximumEdge)
+{
+    if (std::max(input.width(), input.height()) <= maximumEdge)
+        return input.copy(); // The input can be a non-owning DMA view.
+    // Scaling allocates owned pixels; a queued GUI frame must never retain DMA.
+    return input.scaled(maximumEdge, maximumEdge, Qt::KeepAspectRatio, Qt::FastTransformation);
+}
+
+QImage S10Photo::denoise(const QImage &input)
+{
+    if (input.isNull())
+        return {};
+    const QImage source = input.convertToFormat(QImage::Format_RGB32);
+    QImage output = source.copy(); // Keep borders and metadata, never modify the input.
+    if (source.width() < 3 || source.height() < 3)
+        return output;
+    const std::array<int, 256> weights = [] {
+        std::array<int, 256> table{};
+        for (int d = 0; d < 256; ++d)
+            table[d] = 65536 / (256 + d * d);
+        return table;
+    }();
+    const int height = source.height(), width = source.width();
+    const auto *src = source.constBits();
+    auto *dst = output.bits(); // Detach once before parallel workers access disjoint rows.
+    const auto srcStride = source.bytesPerLine(), dstStride = output.bytesPerLine();
+    auto process = [&](int begin, int end) {
+        for (int y = begin; y < end; ++y) {
+            auto *out = reinterpret_cast<QRgb *>(dst + y * dstStride);
+            const auto *row = reinterpret_cast<const QRgb *>(src + y * srcStride);
+            for (int x = 1; x < width - 1; ++x) {
+                const int r = qRed(row[x]), g = qGreen(row[x]), b = qBlue(row[x]);
+                int red = 0, green = 0, blue = 0, total = 0;
+                for (int dy = -1; dy <= 1; ++dy) {
+                    const auto *near = reinterpret_cast<const QRgb *>(src + (y + dy) * srcStride);
+                    for (int dx = -1; dx <= 1; ++dx) {
+                        const QRgb p = near[x + dx];
+                        const int difference = std::max({std::abs(qRed(p) - r),
+                            std::abs(qGreen(p) - g), std::abs(qBlue(p) - b)});
+                        const int spatial = (dx == 0 ? 2 : 1) * (dy == 0 ? 2 : 1);
+                        const int weight = weights[difference] * spatial;
+                        red += weight * qRed(p);
+                        green += weight * qGreen(p);
+                        blue += weight * qBlue(p);
+                        total += weight;
+                    }
+                }
+                red = (red + total / 2) / total;
+                green = (green + total / 2) / total;
+                blue = (blue + total / 2) / total;
+                // Preserve some luminance texture; smooth chroma more strongly.
+                const int correction = ((r + 2 * g + b) - (red + 2 * green + blue)) / 12;
+                out[x] = qRgb(std::clamp(red + correction, 0, 255),
+                              std::clamp(green + correction, 0, 255),
+                              std::clamp(blue + correction, 0, 255));
+            }
+        }
+    };
+    const int count = height >= 256 ? 4 : 1;
+    std::vector<std::jthread> workers;
+    for (int i = 1; i < count; ++i)
+        workers.emplace_back(process, 1 + (height - 2) * i / count,
+                             1 + (height - 2) * (i + 1) / count);
+    process(1, 1 + (height - 2) / count);
+    for (auto &worker : workers)
+        worker.join();
+    return output;
+}
