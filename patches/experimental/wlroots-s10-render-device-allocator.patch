 			&& drm_fd >= 0) {
 #if WLR_HAS_GBM_ALLOCATOR
 		wlr_log(WLR_DEBUG, "Trying to create gbm allocator");
-		int gbm_fd = reopen_drm_node(drm_fd, true);
+		int allocator_fd = drm_fd;
+		const char *s10_render_allocator = getenv("PHOC_S10_RENDER_ALLOCATOR");
