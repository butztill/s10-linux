+	GATE(13, "gout_isppre_dma_qos_aclk", "mout_isppre_bus_user", 0x2054, 21, 0, 0),
+	GATE(14, "gout_isppre_dma_qos_pclk", "dout_isppre_busp", 0x2094, 21, 0, 0),
+};
