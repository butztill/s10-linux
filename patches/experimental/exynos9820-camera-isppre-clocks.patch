+	GATE(8, "gout_isppre_xiud", "mout_isppre_bus_user", 0x2068, 21, 0, 0),
+	GATE(9, "gout_isppre_busd_reset", "mout_isppre_bus_user", 0x20cc, 21, 0, 0),
+	GATE(10, "gout_isppre_busp_reset", "dout_isppre_busp", 0x20d0, 21, 0, 0),
